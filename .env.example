PORT=3000
INTERNAL_PORT=3001
DATABASE_PATH=./data/app.db
APP_VERSION=dev
# Identity's internal base URL, for its lifecycle log and the assignee check.
# Unset: the lifecycle log is disabled and assigning a task returns 503.
# IDENTITY_INTERNAL_URL=http://identity:3001
OTEL_SERVICE_NAME=api
OTEL_RESOURCE_ATTRIBUTES=service.namespace=api,deployment.environment=development
# OTLP export (http/protobuf). Unset = stdout logs + Prometheus /metrics only.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=prometheus
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_METRIC_EXPORT_INTERVAL=60000
# OTEL_TRACES_SAMPLER_RATIO=1
# OTEL_SDK_DISABLED=true
